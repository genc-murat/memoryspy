{
  "name": "memoryspy",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop memory profiler for .NET processes",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "collector:build": "dotnet build collector -c Debug",
    "collector:release": "dotnet build collector -c Release",
    "collector:publish": "node scripts/publish-collector.mjs",
    "sample:build": "dotnet build samples/LeakyCache -c Debug",
    "sample:run": "dotnet run --project samples/LeakyCache --",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "prepare:all": "npm run collector:build && npm run sample:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
